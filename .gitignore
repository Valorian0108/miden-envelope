# dependencies — reinstallable with `pnpm install`, and platform-specific
# (the SDK ships a different binary per OS, so a committed copy would be a lie)
node_modules/

# build output, if anyone ever runs a production build
dist/

# os and editor droppings
Thumbs.db
.DS_Store

# fit-check output: regenerated on every run of capture/fit-check.mjs
capture/fit-*.png

# recorder intermediates: temporary videos playwright drops while making
# film-1440.webm / demo-1440.webm. Regenerable, hash-named, never referenced.
capture/page@*.webm
