# pnpm uses a symlinked, content-addressable store. The Miden SDK resolves its
# 21 MB WASM module by relative path (dist/mt/assets/miden_client_web.wasm), and
# Vite's dev server can fail to follow that through symlinks — surfacing as
# WASM_CLASS_MISMATCH or a missing asset. Hoisting gives npm-style flat layout.
node-linker=hoisted
