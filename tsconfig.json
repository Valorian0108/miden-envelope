{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  /* The stage harnesses (src/stage*.ts, src/main.ts) are evidence scripts run
     through esbuild, which strips types without checking them. They are not part
     of the library and are deliberately outside this check. */
  "include": ["src/envelope", "test", "demo"]
}
